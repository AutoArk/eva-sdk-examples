{
  "name": "eva-client-sdk-ts-electron-conversation-agent",
  "private": true,
  "version": "0.0.0",
  "description": "EVA Client SDK TypeScript Electron conversation agent demo.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5273 --strictPort",
    "dev:electron": "wait-on tcp:127.0.0.1:5273 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5273 electron .",
    "dev:key-file": "node scripts/run-npm-demo-with-key-file.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "postbuild": "node scripts/verify-dist-paths.mjs",
    "start": "electron ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@autoark-ai/eva-client-sdk-ts": "1.0.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.4",
    "wait-on": "^8.0.1"
  }
}
